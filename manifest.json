{
  "name": "HYROX — Train with purpose",
  "short_name": "HYROX",
  "description": "A focused five-day, 40-minute HYROX training companion. Sports Watch design with real-time target tracking.",
  "start_url": "./",
  "display": "standalone",
  "scope": "./",
  "orientation": "portrait-primary",
  "background_color": "#0d0d0d",
  "theme_color": "#00ff00",
  "prefer_related_applications": false,
  "screenshots": [
    {
      "src": "icon-apple.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "purpose": "maskable any"
    }
  ],
  "icons": [
    {
      "src": "icon-apple.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable",
      "platform": "ios"
    },
    {
      "src": "icon-apple.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": ["fitness", "sports"],
  "shortcuts": [
    {
      "name": "Start Workout",
      "short_name": "Start",
      "description": "Begin today's HYROX workout",
      "url": "./?action=start",
      "icons": [
        {
          "src": "icon-apple.svg",
          "sizes": "192x192",
          "type": "image/svg+xml",
          "purpose": "maskable"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+hyrox",
      "url": "./?protocol=%s"
    }
  ],
  "share_target": {
    "action": "/?action=import",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "workout_data",
          "accept": ["application/json"]
        }
      ]
    }
  }
}
